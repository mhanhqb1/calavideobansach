   "len": 43,
   "first": 3395,
   "line": "kèm hàng nghìn lượt chia sẻ.",
   "note": "lượt chia sẻ tăng"
  },
  {
   "id": "S44",
   "size": "card",
   "key": 30,
   "len": 63,
   "first": 3438,
   "line": "Nhưng lượt chia sẻ không phải là bằng chứng.",
   "note": "không phải bằng chứng"
  },
  {
   "id": "S45",
   "size": "close-up",
   "key": 18,
   "len": 65,
   "first": 3501,
   "line": "Hãy hỏi: ai nói điều này?",
   "note": "ai nói"
  },
  {
   "id": "S46",
   "size": "close-up",
   "key": 18,
   "len": 42,
   "first": 3566,
   "line": "Có nghiên cứu nào không?",
   "note": "nghiên cứu nào"
  },
  {
   "id": "S47",
   "size": "close-up",
   "key": 18,
   "len": 55,
   "first": 3608,
   "line": "Và ai được lợi nếu mình tin?",
   "note": "ai được lợi"
  },
  {
   "id": "S48",
   "size": "card",
   "key": 30,
   "len": 88,
   "first": 3663,
   "line": "Người hay bị dắt mũi không phải là người kém thông minh.",
   "note": "không kém thông minh"
  },
  {
   "id": "S49",
   "size": "card",
   "key": 30,
   "len": 71,
   "first": 3751,
   "line": "Đó là người quên hỏi câu: dựa vào đâu.",
   "note": "quên hỏi dựa vào đâu"
  },
  {
   "id": "S50",
   "size": "card",
   "key": 30,
   "len": 108,
   "first": 3822,
   "line": "Câu hỏi thứ tư: nếu đứng ở chỗ người kia, mình sẽ thấy gì?",
   "note": "CÂU 4"
  },
  {
   "id": "S51",
   "size": "close-up",
   "key": 18,
   "len": 98,
   "first": 3930,
   "line": "Mẹ gọi điện lần thứ ba trong ngày, chỉ để nhắc bạn mặc áo ấm.",
   "note": "mẹ gọi nhắc áo ấm"
  },
  {
   "id": "S52",
   "size": "close-up",
   "key": 18,
   "len": 59,
   "first": 4028,
   "line": "Bạn bực: con lớn rồi mà.",
   "note": "bạn bực"
  },
  {
   "id": "S53",
   "size": "close-up",
   "key": 18,
   "len": 95,
   "first": 4087,
   "line": "Nhưng đứng ở chỗ mẹ, bạn sẽ thấy một người vừa xem tin bão,",
   "note": "mẹ xem tin bão"
  },
  {
   "id": "S54",
   "size": "close-up",
   "key": 18,
   "len": 53,
   "first": 4182,
   "line": "và đứa con thì đang ở xa.",
   "note": "con ở xa"
  },
  {
   "id": "S55",
   "size": "drawing",
   "key": 30,
   "len": 90,
   "first": 4235,
   "line": "Số sáu, nhìn từ phía bên kia, là số chín.",
   "note": "6 hay 9"
  },
  {
   "id": "S56",
   "size": "drawing",
   "key": 30,
   "len": 91,
   "first": 4325,
   "line": "Cả hai đều không sai. Họ chỉ đứng ở hai phía.",
   "note": "cả hai không sai"
  },
  {
   "id": "S57",
   "size": "card",
   "key": 30,
   "len": 97,
   "first": 4416,
   "line": "Câu hỏi thứ năm: nếu làm vậy, rồi sau đó thì sao?",
   "note": "CÂU 5"
  },
  {
   "id": "S58",
   "size": "group",
   "key": 30,
   "len": 41,
   "first": 4513,
   "line": "Bị sếp mắng trước cả phòng,",
   "note": "bị sếp mắng trước cả phòng"
  },
  {
   "id": "S59",
   "size": "close-up",
   "key": 18,
   "len": 60,
   "first": 4554,
   "line": "bạn muốn viết đơn nghỉ việc ngay tối nay.",
   "note": "muốn nghỉ việc"
  },
  {
   "id": "S60",
   "size": "close-up",
   "key": 18,
   "len": 62,
   "first": 4614,
   "line": "Hãy hỏi tiếp: nghỉ rồi thì sao?",
   "note": "nghỉ rồi thì sao"
  },
  {
   "id": "S61",
   "size": "card",
   "key": 30,
   "len": 52,
   "first": 4676,
   "line": "Tháng sau tiền nhà lấy đâu ra?",
   "note": "tiền nhà"
  },
  {
   "id": "S62",
   "size": "two-shot",
   "key": 30,
   "len": 66,
   "first": 4728,
   "line": "Đi phỏng vấn, mình sẽ kể lý do gì?",
   "note": "phỏng vấn hỏi lý do"
  },
  {
   "id": "S63",
   "size": "drawing",
   "key": 30,
   "len": 59,
   "first": 4794,
   "line": "Mỗi quyết định là một quân domino.",
   "note": "domino"
  },
  {
   "id": "S64",
   "size": "drawing",
   "key": 30,
   "len": 69,
   "first": 4853,
   "line": "Người khôn không phải là người không biết giận.",
   "note": "quân thứ 3"
  },
  {
   "id": "S65",
   "size": "close-up",
   "key": 18,
   "len": 100,
   "first": 4922,
   "line": "Họ chỉ nhìn thấy quân domino thứ ba, trước khi đẩy quân thứ nhất.",
   "note": "người khôn"
  },
  {
   "id": "S66",
   "size": "card",
   "key": 30,
   "len": 110,
   "first": 5022,
   "line": "Và câu hỏi thứ sáu, khó nhất: mình có đang hỏi đúng câu không?",
   "note": "CÂU 6"
  },
  {
   "id": "S67",
   "size": "close-up",
   "key": 18,
   "len": 76,
   "first": 5132,
   "line": "Rất nhiều người hỏi: làm sao để kiếm thêm tiền?",
   "note": "làm sao kiếm thêm tiền"
  },
  {
   "id": "S68",
   "size": "close-up",
   "key": 18,
   "len": 54,
   "first": 5208,
   "line": "Họ nhận thêm việc, làm đến khuya,",
   "note": "làm đến khuya"
  },
  {
   "id": "S69",
   "size": "close-up",
   "key": 18,
   "len": 48,
   "first": 5262,
   "line": "mà cuối tháng vẫn hết sạch.",
   "note": "cuối tháng hết sạch"
  },
  {
   "id": "S70",
   "size": "card",
   "key": 30,
   "len": 101,
   "first": 5310,
   "line": "Câu hỏi đúng, có khi lại là: tiền của mình đang đi đâu?",
   "note": "tiền đi đâu"
  },
  {
   "id": "S71",
   "size": "card",
   "key": 30,
   "len": 99,
   "first": 5411,
   "line": "Hỏi sai câu, bạn chăm chỉ giải một bài toán không có thật.",
   "note": "bài toán không có thật"
  },
  {
   "id": "S72",
   "size": "drawing",
   "key": 30,
   "len": 95,
   "first": 5510,
   "line": "Giống như cầm chìa khoá đúng, nhưng tra vào sai ổ.",
   "note": "chìa đúng sai ổ"
  },
  {
   "id": "S73",
   "size": "close-up",
   "key": 18,
   "len": 55,
   "first": 5605,
   "line": "Nhưng cẩn thận. Sáu câu hỏi này,",
   "note": "cẩn thận"
  },
  {
   "id": "S74",
   "size": "card",
   "key": 30,
   "len": 64,
   "first": 5660,
   "line": "dùng sai thì thành tra hỏi.",
   "note": "thành tra hỏi"
  },
  {
   "id": "S75",
   "size": "two-shot",
   "key": 30,
   "len": 103,
   "first": 5724,
   "line": "Nếu bạn hỏi để bắt bẻ, để chứng minh người kia sai, để mình thắng,",
   "note": "hỏi để bắt bẻ"
  },
  {
   "id": "S76",
   "size": "close-up",
   "key": 18,
   "len": 49,
   "first": 5827,
   "line": "thì người ta sẽ đóng cửa lại ngay.",
   "note": "đóng cửa"
  },
  {
   "id": "S77",
   "size": "card",
   "key": 30,
   "len": 60,
   "first": 5876,
   "line": "Socrates hỏi không phải để thắng.",
   "note": "không để thắng"
  },
  {
   "id": "S78",
   "size": "card",
   "key": 30,
   "len": 59,
   "first": 5936,
   "line": "Ông hỏi để cả hai cùng hiểu rõ hơn.",
   "note": "để cùng hiểu"
  },
  {
   "id": "S79",
   "size": "card",
   "key": 30,
   "len": 49,
   "first": 5995,
   "line": "Khác nhau chỉ ở giọng nói:",
   "note": "giọng nói"
  },
  {
   "id": "S80",
   "size": "two-shot",
   "key": 30,
   "len": 79,
   "first": 6044,
   "line": "một bên là thẩm vấn, một bên là tò mò.",
   "note": "thẩm vấn / tò mò"
  },
  {
   "id": "S81",
   "size": "drawing",
   "key": 30,
   "len": 121,
   "first": 6123,
   "line": "Có một câu người ta gắn với Socrates suốt hai mươi bốn thế kỷ:",
   "note": "24 thế kỷ"
  },
  {
   "id": "S82",
   "size": "quote",
   "key": 30,
   "len": 83,
   "first": 6244,
   "line": "tôi chỉ biết một điều, là tôi không biết gì cả.",
   "note": "tôi không biết gì"
  },
  {
   "id": "S83",
   "size": "close-up",
   "key": 18,
   "len": 75,
   "first": 6327,
   "line": "Nghe thì khiêm tốn, nhưng đó là vũ khí.",
   "note": "khiêm tốn"
  },
  {
   "id": "S84",
   "size": "card",
   "key": 30,
   "len": 93,
   "first": 6402,
   "line": "Vì chỉ khi thừa nhận mình chưa biết, bạn mới bắt đầu hỏi.",
   "note": "thừa nhận chưa biết"
  },
  {
   "id": "S85",
   "size": "close-up",
   "key": 18,
   "len": 104,
   "first": 6495,
   "line": "Còn người nghĩ mình biết hết, sẽ không bao giờ hỏi thêm một câu nào.",
   "note": "người biết hết"
  },
  {
   "id": "S86",
   "size": "title",
   "key": 30,
   "len": 45,
   "first": 6599,
   "line": "Vậy luyện thế nào?",
   "note": "luyện thế nào"
  },
  {
   "id": "S87",
   "size": "card",
   "key": 30,
   "len": 46,
   "first": 6644,
   "line": "Thứ nhất, luật ba giây.",
   "note": "cách 1 luật ba giây"
  },
  {
   "id": "S88",
   "size": "close-up",
   "key": 18,
   "len": 114,
   "first": 6690,
   "line": "Trước khi tin một tin, trước khi phản bác ai, trước khi quyết định điều gì lớn,",
   "note": "tin sốc"
  },
  {
   "id": "S89",
   "size": "drawing",
   "key": 30,
   "len": 77,
   "first": 6804,
   "line": "hãy dừng lại ba giây, và hỏi đúng một câu:",
   "note": "đếm 3 giây"
  },
  {
   "id": "S90",
   "size": "card",
   "key": 30,
   "len": 63,
   "first": 6881,
   "line": "dựa vào đâu? Chỉ một câu thôi.",
   "note": "dựa vào đâu"
  },
  {
   "id": "S91",
   "size": "close-up",
   "key": 18,
   "len": 67,
   "first": 6944,
   "line": "Làm đủ lâu, nó sẽ thành phản xạ.",
   "note": "thành phản xạ"
  },
  {
   "id": "S92",
   "size": "card",
   "key": 30,
   "len": 63,
   "first": 7011,
   "line": "Thứ hai, mười phút mỗi tối.",
   "note": "cách 2 mười phút"
  },
  {
   "id": "S93",
   "size": "close-up",
   "key": 18,
   "len": 74,
   "first": 7074,
   "line": "Lấy giấy ra, viết một điều bạn đang tin chắc.",
   "note": "lấy giấy ra"
  },
  {
   "id": "S94",
   "size": "card",
   "key": 30,
   "len": 77,
   "first": 7148,
   "line": "Ví dụ: mình không hợp với công việc này.",
   "note": "điều tin chắc"
  },
  {
   "id": "S95",
   "size": "close-up",
   "key": 18,
   "len": 50,
   "first": 7225,
   "line": "Rồi hỏi nó đủ sáu câu.",
   "note": "hỏi đủ sáu câu"
  },
  {
   "id": "S111",
   "size": "list",
   "key": 30,
   "len": 80,
   "first": 7275,
   "line": "Ý mình chính xác là gì? Mình đang mặc định gì?",
   "note": "câu 1-2"
  },
  {
   "id": "S96",
   "size": "list",
   "key": 30,
   "len": 72,
   "first": 7355,
   "line": "Dựa vào đâu? Người khác sẽ nhìn ra sao?",
   "note": "câu 3-4"
  },
  {
   "id": "S97",
   "size": "list",
   "key": 30,
   "len": 93,
   "first": 7427,
   "line": "Rồi sau đó thì sao? Và mình có đang hỏi đúng câu không?",
   "note": "câu 5-6"
  },
  {
   "id": "S98",
   "size": "close-up",
   "key": 18,
   "len": 89,
   "first": 7520,
   "line": "Nhiều điều bạn tin chắc, sẽ lung lay ngay ở câu thứ ba.",
   "note": "lung lay"
  },
  {
   "id": "S99",
   "size": "card",
   "key": 30,
   "len": 59,
   "first": 7609,
   "line": "Thứ ba, hỏi trước khi cãi.",
   "note": "cách 3 hỏi trước khi cãi"
  },
  {
   "id": "S100",
   "size": "two-shot",
   "key": 30,
   "len": 75,
   "first": 7668,
   "line": "Lần tới, khi có người nói điều bạn không đồng ý,",
   "note": "người nói điều bạn không đồng ý"
  },
  {
   "id": "S101",
   "size": "close-up",
   "key": 18,
   "len": 63,
   "first": 7743,
   "line": "đừng phản bác ngay. Hãy hỏi:",
   "note": "đừng phản bác"
  },
  {
   "id": "S102",
   "size": "two-shot",
   "key": 30,
   "len": 79,
   "first": 7806,
   "line": "sao bạn lại nghĩ vậy? Bạn sẽ ngạc nhiên.",
   "note": "sao bạn nghĩ vậy"
  },
  {
   "id": "S103",
   "size": "two-shot",
   "key": 30,
   "len": 62,
   "first": 7885,
   "line": "Nhiều lần, bạn hiểu ra họ có lý.",
   "note": "họ có lý"
  },
  {
   "id": "S104",
   "size": "close-up",
   "key": 18,
   "len": 86,
   "first": 7947,
   "line": "Những lần khác, chính họ tự nhận ra chỗ hổng trong lời mình,",
   "note": "họ tự nhận ra"
  },
  {
   "id": "S105",
   "size": "close-up",
   "key": 18,
   "len": 55,
   "first": 8033,
   "line": "mà bạn không cần nói thêm câu nào.",
   "note": "không cần nói"
  },
  {
   "id": "S106",
   "size": "drawing",
   "key": 30,
   "len": 76,
   "first": 8088,
   "line": "Sáu câu hỏi tôi vừa nói mới chỉ là phần nổi.",
   "note": "phần nổi"
  },
  {
   "id": "S107",
   "size": "book",
   "key": 30,
   "len": 96,
   "first": 8164,
   "line": "Nếu bạn muốn luyện kỹ hơn, cuốn Phương Pháp Đặt Câu Hỏi Của Socrates",
   "note": "luyện kỹ hơn"
  },
  {
   "id": "S108",
   "size": "close-up",
   "key": 18,
   "len": 90,
   "first": 8260,
   "line": "có đủ các dạng câu hỏi, cách tìm ra những giả định ẩn,",
   "note": "cầm sách"
  },
  {
   "id": "S112",
   "size": "card",
   "key": 30,
   "len": 117,
   "first": 8350,
   "line": "và rất nhiều ví dụ trong công việc lẫn cuộc sống, để bạn tự tập mỗi ngày.",
   "note": "tự tập mỗi ngày"
  },
  {
   "id": "S119",
   "size": "two-shot",
   "key": 30,
   "len": 118,
   "first": 8467,
   "line": "Giờ thì quay lại câu hỏi lúc nãy: bạn đang là kiểu một, hay kiểu hai?",
   "note": "kiểu một hay kiểu hai"
  },
  {
   "id": "S120",
   "size": "close-up",
   "key": 18,
   "len": 98,
   "first": 8585,
   "line": "Và lần gần nhất bạn tin chắc một điều, rồi mới phát hiện là sai,",
   "note": "lần gần nhất tin sai"
  },
  {
   "id": "S124",
   "size": "close-up",
   "key": 18,
   "len": 88,
   "first": 8683,
   "line": "đó là chuyện gì? Kể cho mình nghe ở phần bình luận nhé.",
   "note": "đó là chuyện gì, kể ở bình luận"
  },
  {
   "id": "S122",
   "size": "two-shot",
   "key": 30,
   "len": 126,
   "first": 8771,
   "line": "Nếu bạn có một người bạn sắp phải ra một quyết định lớn, có lẽ video này dành cho họ.",
   "note": "người bạn sắp quyết định lớn"
  },
  {
   "id": "S114",
   "size": "title",
   "key": 30,
   "len": 107,
   "first": 8897,
   "line": "Và nhớ nhé: người ta không khôn lên nhờ có nhiều câu trả lời.",
   "note": "không khôn nhờ câu trả lời"
  },
  {
   "id": "S115",
   "size": "title",
   "key": 30,
   "len": 123,
   "first": 9004,
   "line": "Người ta khôn lên, nhờ biết hỏi đúng câu.",
   "note": "khôn nhờ hỏi đúng câu"
  }
