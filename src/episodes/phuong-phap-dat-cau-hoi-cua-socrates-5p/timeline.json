   "line": "và đứa con thì đang ở xa.",
   "note": "con ở xa"
  },
  {
   "id": "S55",
   "size": "drawing",
   "key": 30,
   "len": 90,
   "first": 3920,
   "line": "Số sáu, nhìn từ phía bên kia, là số chín.",
   "note": "6 hay 9"
  },
  {
   "id": "S56",
   "size": "drawing",
   "key": 30,
   "len": 92,
   "first": 4010,
   "line": "Cả hai đều không sai. Họ chỉ đứng ở hai phía.",
   "note": "cả hai không sai"
  },
  {
   "id": "S57",
   "size": "card",
   "key": 30,
   "len": 97,
   "first": 4102,
   "line": "Câu hỏi thứ năm: nếu làm vậy, rồi sau đó thì sao?",
   "note": "CÂU 5"
  },
  {
   "id": "S58",
   "size": "group",
   "key": 30,
   "len": 40,
   "first": 4199,
   "line": "Bị sếp mắng trước cả phòng,",
   "note": "bị sếp mắng trước cả phòng"
  },
  {
   "id": "S59",
   "size": "close-up",
   "key": 18,
   "len": 61,
   "first": 4239,
   "line": "bạn muốn viết đơn nghỉ việc ngay tối nay.",
   "note": "muốn nghỉ việc"
  },
  {
   "id": "S60",
   "size": "close-up",
   "key": 18,
   "len": 62,
   "first": 4300,
   "line": "Hãy hỏi tiếp: nghỉ rồi thì sao?",
   "note": "nghỉ rồi thì sao"
  },
  {
   "id": "S61",
   "size": "card",
   "key": 30,
   "len": 51,
   "first": 4362,
   "line": "Tháng sau tiền nhà lấy đâu ra?",
   "note": "tiền nhà"
  },
  {
   "id": "S62",
   "size": "two-shot",
   "key": 30,
   "len": 67,
   "first": 4413,
   "line": "Đi phỏng vấn, mình sẽ kể lý do gì?",
   "note": "phỏng vấn hỏi lý do"
  },
  {
   "id": "S63",
   "size": "drawing",
   "key": 30,
   "len": 59,
   "first": 4480,
   "line": "Mỗi quyết định là một quân domino.",
   "note": "domino"
  },
  {
   "id": "S64",
   "size": "drawing",
   "key": 30,
   "len": 69,
   "first": 4539,
   "line": "Người khôn không phải là người không biết giận.",
   "note": "quân thứ 3"
  },
  {
   "id": "S65",
   "size": "close-up",
   "key": 18,
   "len": 100,
   "first": 4608,
   "line": "Họ chỉ nhìn thấy quân domino thứ ba, trước khi đẩy quân thứ nhất.",
   "note": "người khôn"
  },
  {
   "id": "S66",
   "size": "card",
   "key": 30,
   "len": 109,
   "first": 4708,
   "line": "Và câu hỏi thứ sáu, khó nhất: mình có đang hỏi đúng câu không?",
   "note": "CÂU 6"
  },
  {
   "id": "S67",
   "size": "close-up",
   "key": 18,
   "len": 77,
   "first": 4817,
   "line": "Rất nhiều người hỏi: làm sao để kiếm thêm tiền?",
   "note": "làm sao kiếm thêm tiền"
  },
  {
   "id": "S68",
   "size": "close-up",
   "key": 18,
   "len": 53,
   "first": 4894,
   "line": "Họ nhận thêm việc, làm đến khuya,",
   "note": "làm đến khuya"
  },
  {
   "id": "S69",
   "size": "close-up",
   "key": 18,
   "len": 49,
   "first": 4947,
   "line": "mà cuối tháng vẫn hết sạch.",
   "note": "cuối tháng hết sạch"
  },
  {
   "id": "S70",
   "size": "card",
   "key": 30,
   "len": 101,
   "first": 4996,
   "line": "Câu hỏi đúng, có khi lại là: tiền của mình đang đi đâu?",
   "note": "tiền đi đâu"
  },
  {
   "id": "S71",
   "size": "card",
   "key": 30,
   "len": 98,
   "first": 5097,
   "line": "Hỏi sai câu, bạn chăm chỉ giải một bài toán không có thật.",
   "note": "bài toán không có thật"
  },
  {
   "id": "S72",
   "size": "drawing",
   "key": 30,
   "len": 96,
   "first": 5195,
   "line": "Giống như cầm chìa khoá đúng, nhưng tra vào sai ổ.",
   "note": "chìa đúng sai ổ"
  },
  {
   "id": "S73",
   "size": "close-up",
   "key": 18,
   "len": 54,
   "first": 5291,
   "line": "Nhưng cẩn thận. Sáu câu hỏi này,",
   "note": "cẩn thận"
  },
  {
   "id": "S74",
   "size": "card",
   "key": 30,
   "len": 65,
   "first": 5345,
   "line": "dùng sai thì thành tra hỏi.",
   "note": "thành tra hỏi"
  },
  {
   "id": "S75",
   "size": "two-shot",
   "key": 30,
   "len": 103,
   "first": 5410,
   "line": "Nếu bạn hỏi để bắt bẻ, để chứng minh người kia sai, để mình thắng,",
   "note": "hỏi để bắt bẻ"
  },
  {
   "id": "S76",
   "size": "close-up",
   "key": 18,
   "len": 49,
   "first": 5513,
   "line": "thì người ta sẽ đóng cửa lại ngay.",
   "note": "đóng cửa"
  },
  {
   "id": "S77",
   "size": "card",
   "key": 30,
   "len": 60,
   "first": 5562,
   "line": "Socrates hỏi không phải để thắng.",
   "note": "không để thắng"
  },
  {
   "id": "S78",
   "size": "card",
   "key": 30,
   "len": 59,
   "first": 5622,
   "line": "Ông hỏi để cả hai cùng hiểu rõ hơn.",
   "note": "để cùng hiểu"
  },
  {
   "id": "S79",
   "size": "card",
   "key": 30,
   "len": 48,
   "first": 5681,
   "line": "Khác nhau chỉ ở giọng nói:",
   "note": "giọng nói"
  },
  {
   "id": "S80",
   "size": "two-shot",
   "key": 30,
   "len": 80,
   "first": 5729,
   "line": "một bên là thẩm vấn, một bên là tò mò.",
   "note": "thẩm vấn / tò mò"
  },
  {
   "id": "S81",
   "size": "drawing",
   "key": 30,
   "len": 121,
   "first": 5809,
   "line": "Có một câu người ta gắn với Socrates suốt hai mươi bốn thế kỷ:",
   "note": "24 thế kỷ"
  },
  {
   "id": "S82",
   "size": "quote",
   "key": 30,
   "len": 82,
   "first": 5930,
   "line": "tôi chỉ biết một điều, là tôi không biết gì cả.",
   "note": "tôi không biết gì"
  },
  {
   "id": "S83",
   "size": "close-up",
   "key": 18,
   "len": 76,
   "first": 6012,
   "line": "Nghe thì khiêm tốn, nhưng đó là vũ khí.",
   "note": "khiêm tốn"
  },
  {
   "id": "S84",
   "size": "card",
   "key": 30,
   "len": 92,
   "first": 6088,
   "line": "Vì chỉ khi thừa nhận mình chưa biết, bạn mới bắt đầu hỏi.",
   "note": "thừa nhận chưa biết"
  },
  {
   "id": "S85",
   "size": "close-up",
   "key": 18,
   "len": 105,
   "first": 6180,
   "line": "Còn người nghĩ mình biết hết, sẽ không bao giờ hỏi thêm một câu nào.",
   "note": "người biết hết"
  },
  {
   "id": "S86",
   "size": "title",
   "key": 30,
   "len": 44,
   "first": 6285,
   "line": "Vậy luyện thế nào?",
   "note": "luyện thế nào"
  },
  {
   "id": "S87",
   "size": "card",
   "key": 30,
   "len": 47,
   "first": 6329,
   "line": "Thứ nhất, luật ba giây.",
   "note": "cách 1 luật ba giây"
  },
  {
   "id": "S88",
   "size": "close-up",
   "key": 18,
   "len": 114,
   "first": 6376,
   "line": "Trước khi tin một tin, trước khi phản bác ai, trước khi quyết định điều gì lớn,",
   "note": "tin sốc"
  },
  {
   "id": "S89",
   "size": "drawing",
   "key": 30,
   "len": 77,
   "first": 6490,
   "line": "hãy dừng lại ba giây, và hỏi đúng một câu:",
   "note": "đếm 3 giây"
  },
  {
   "id": "S90",
   "size": "card",
   "key": 30,
   "len": 63,
   "first": 6567,
   "line": "dựa vào đâu? Chỉ một câu thôi.",
   "note": "dựa vào đâu"
  },
  {
   "id": "S91",
   "size": "close-up",
   "key": 18,
   "len": 67,
   "first": 6630,
   "line": "Làm đủ lâu, nó sẽ thành phản xạ.",
   "note": "thành phản xạ"
  },
  {
   "id": "S92",
   "size": "card",
   "key": 30,
   "len": 62,
   "first": 6697,
   "line": "Thứ hai, mười phút mỗi tối.",
   "note": "cách 2 mười phút"
  },
  {
   "id": "S93",
   "size": "close-up",
   "key": 18,
   "len": 75,
   "first": 6759,
   "line": "Lấy giấy ra, viết một điều bạn đang tin chắc.",
   "note": "lấy giấy ra"
  },
  {
   "id": "S94",
   "size": "card",
   "key": 30,
   "len": 77,
   "first": 6834,
   "line": "Ví dụ: mình không hợp với công việc này.",
   "note": "điều tin chắc"
  },
  {
   "id": "S95",
   "size": "close-up",
   "key": 18,
   "len": 50,
   "first": 6911,
   "line": "Rồi hỏi nó đủ sáu câu.",
   "note": "hỏi đủ sáu câu"
  },
  {
   "id": "S111",
   "size": "list",
   "key": 30,
   "len": 80,
   "first": 6961,
   "line": "Ý mình chính xác là gì? Mình đang mặc định gì?",
   "note": "câu 1-2"
  },
  {
   "id": "S96",
   "size": "list",
   "key": 30,
   "len": 72,
   "first": 7041,
   "line": "Dựa vào đâu? Người khác sẽ nhìn ra sao?",
   "note": "câu 3-4"
  },
  {
   "id": "S97",
   "size": "list",
   "key": 30,
   "len": 93,
   "first": 7113,
   "line": "Rồi sau đó thì sao? Và mình có đang hỏi đúng câu không?",
   "note": "câu 5-6"
  },
  {
   "id": "S98",
   "size": "close-up",
   "key": 18,
   "len": 89,
   "first": 7206,
   "line": "Nhiều điều bạn tin chắc, sẽ lung lay ngay ở câu thứ ba.",
   "note": "lung lay"
  },
  {
   "id": "S99",
   "size": "card",
   "key": 30,
   "len": 59,
   "first": 7295,
   "line": "Thứ ba, hỏi trước khi cãi.",
   "note": "cách 3 hỏi trước khi cãi"
  },
  {
   "id": "S100",
   "size": "two-shot",
   "key": 30,
   "len": 74,
   "first": 7354,
   "line": "Lần tới, khi có người nói điều bạn không đồng ý,",
   "note": "người nói điều bạn không đồng ý"
  },
  {
   "id": "S101",
   "size": "close-up",
   "key": 18,
   "len": 64,
   "first": 7428,
   "line": "đừng phản bác ngay. Hãy hỏi:",
   "note": "đừng phản bác"
  },
  {
   "id": "S102",
   "size": "two-shot",
   "key": 30,
   "len": 79,
   "first": 7492,
   "line": "sao bạn lại nghĩ vậy? Bạn sẽ ngạc nhiên.",
   "note": "sao bạn nghĩ vậy"
  },
  {
   "id": "S103",
   "size": "two-shot",
   "key": 30,
   "len": 62,
   "first": 7571,
   "line": "Nhiều lần, bạn hiểu ra họ có lý.",
   "note": "họ có lý"
  },
  {
   "id": "S104",
   "size": "close-up",
   "key": 18,
   "len": 85,
   "first": 7633,
   "line": "Những lần khác, chính họ tự nhận ra chỗ hổng trong lời mình,",
   "note": "họ tự nhận ra"
  },
  {
   "id": "S105",
   "size": "close-up",
   "key": 18,
   "len": 56,
   "first": 7718,
   "line": "mà bạn không cần nói thêm câu nào.",
   "note": "không cần nói"
  },
  {
   "id": "S106",
   "size": "drawing",
   "key": 30,
   "len": 76,
   "first": 7774,
   "line": "Sáu câu hỏi tôi vừa nói mới chỉ là phần nổi.",
   "note": "phần nổi"
  },
  {
   "id": "S107",
   "size": "book",
   "key": 30,
   "len": 96,
   "first": 7850,
   "line": "Nếu bạn muốn luyện kỹ hơn, cuốn Phương Pháp Đặt Câu Hỏi Của Socrates",
   "note": "luyện kỹ hơn"
  },
  {
   "id": "S108",
   "size": "close-up",
   "key": 18,
   "len": 90,
   "first": 7946,
   "line": "có đủ các dạng câu hỏi, cách tìm ra những giả định ẩn,",
   "note": "cầm sách"
  },
  {
   "id": "S112",
   "size": "card",
   "key": 30,
   "len": 117,
   "first": 8036,
   "line": "và rất nhiều ví dụ trong công việc lẫn cuộc sống, để bạn tự tập mỗi ngày.",
   "note": "tự tập mỗi ngày"
  },
  {
   "id": "S113",
   "size": "close-up",
   "key": 18,
   "len": 34,
   "first": 8153,
   "line": "Và nhớ nhé:",
   "note": "và nhớ nhé"
  },
  {
   "id": "S114",
   "size": "title",
   "key": 30,
   "len": 89,
   "first": 8187,
   "line": "người ta không khôn lên nhờ có nhiều câu trả lời.",
   "note": "không khôn nhờ câu trả lời"
  },
  {
   "id": "S115",
   "size": "title",
   "key": 30,
   "len": 137,
   "first": 8276,
   "line": "Người ta khôn lên, nhờ biết hỏi đúng câu.",
   "note": "khôn nhờ hỏi đúng câu"
  }
