   "line": "Lắng nghe, và khuyến khích người khác nói về chính họ.",
   "note": "lắng nghe"
  },
  {
   "id": "S57",
   "size": "wide",
   "key": 30,
   "len": 49,
   "first": 4097,
   "line": "Bạn gặp vị khách hàng khó tính nhất.",
   "note": "khách hàng khó tính"
  },
  {
   "id": "S58",
   "size": "close-up",
   "key": 18,
   "len": 35,
   "first": 4146,
   "line": "Bạn không chào hàng.",
   "note": "không chào hàng"
  },
  {
   "id": "S59",
   "size": "two-shot",
   "key": 30,
   "len": 12,
   "first": 4181,
   "line": "Bạn hỏi",
   "note": "hỏi về sự nghiệp"
  },
  {
   "id": "S60",
   "size": "wide",
   "key": 30,
   "len": 100,
   "first": 4193,
   "line": "anh ấy đã bắt đầu sự nghiệp thế nào. Anh nói suốt một tiếng.",
   "note": "nói suốt 1 tiếng"
  },
  {
   "id": "S61",
   "size": "wide",
   "key": 30,
   "len": 59,
   "first": 4293,
   "line": "Cuối buổi, anh ký hợp đồng.",
   "note": "ký hợp đồng"
  },
  {
   "id": "S62",
   "size": "close-up",
   "key": 18,
   "len": 63,
   "first": 4352,
   "line": "Còn bạn, chỉ nói đúng vài câu.",
   "note": "chỉ nói vài câu"
  },
  {
   "id": "S63",
   "size": "insert",
   "key": 30,
   "len": 30,
   "first": 4415,
   "line": "Ngày 16.",
   "note": "NGÀY 16"
  },
  {
   "id": "S64",
   "size": "card",
   "key": 30,
   "len": 131,
   "first": 4445,
   "line": "Luật cuối của phần hai: làm người khác thấy mình quan trọng, một cách chân thành.",
   "note": "làm người khác thấy quan trọng"
  },
  {
   "id": "S65",
   "size": "wide",
   "key": 30,
   "len": 119,
   "first": 4576,
   "line": "Carnegie kể, ở một bưu điện, ông thấy anh nhân viên cân thư uể oải.",
   "note": "nhân viên bưu điện uể oải"
  },
  {
   "id": "S66",
   "size": "two-shot",
   "key": 30,
   "len": 50,
   "first": 4695,
   "line": "Ông khen mái tóc anh thật đẹp.",
   "note": "khen mái tóc"
  },
  {
   "id": "S67",
   "size": "close-up",
   "key": 18,
   "len": 56,
   "first": 4745,
   "line": "Anh ngẩng lên, cười rạng rỡ.",
   "note": "cười rạng rỡ"
  },
  {
   "id": "S68",
   "size": "wide",
   "key": 30,
   "len": 116,
   "first": 4801,
   "line": "Carnegie chẳng cần gì từ anh ấy. Ông chỉ muốn để lại một chút niềm vui.",
   "note": "một chút niềm vui"
  },
  {
   "id": "S69",
   "size": "insert",
   "key": 30,
   "len": 34,
   "first": 4917,
   "line": "Ngày 18.",
   "note": "NGÀY 18"
  },
  {
   "id": "S70",
   "size": "card",
   "key": 30,
   "len": 58,
   "first": 4951,
   "line": "Phần ba: thuyết phục người khác.",
   "note": "phần 3"
  },
  {
   "id": "S71",
   "size": "quote",
   "key": 30,
   "len": 114,
   "first": 5009,
   "line": "Luật đầu tiên nghe lạ nhất: cách duy nhất để thắng một cuộc tranh cãi là tránh nó.",
   "note": "tránh tranh cãi"
  },
  {
   "id": "S72",
   "size": "two-shot",
   "key": 30,
   "len": 114,
   "first": 5123,
   "line": "Vì kể cả khi bạn thắng, người kia vẫn thấy mình bị bẽ mặt.",
   "note": "thắng mà người kia bẽ mặt"
  },
  {
   "id": "S73",
   "size": "wide",
   "key": 30,
   "len": 132,
   "first": 5237,
   "line": "Ở buổi họp, bạn nói: có thể tôi sai, mình cùng xem lại nhé.",
   "note": "có thể tôi sai"
  },
  {
   "id": "S74",
   "size": "wide",
   "key": 30,
   "len": 35,
   "first": 5369,
   "line": "Cả phòng dịu hẳn.",
   "note": "cả phòng dịu hẳn"
  },
  {
   "id": "S75",
   "size": "insert",
   "key": 30,
   "len": 39,
   "first": 5404,
   "line": "Ngày 19.",
   "note": "NGÀY 19"
  },
  {
   "id": "S76",
   "size": "card",
   "key": 30,
   "len": 63,
   "first": 5443,
   "line": "Bạn học cách khiến người khác nói vâng.",
   "note": "nói vâng"
  },
  {
   "id": "S77",
   "size": "card",
   "key": 30,
   "len": 49,
   "first": 5506,
   "line": "Đừng mở đầu bằng điểm bất đồng.",
   "note": "đừng mở đầu bằng bất đồng"
  },
  {
   "id": "S78",
   "size": "card",
   "key": 30,
   "len": 63,
   "first": 5555,
   "line": "Hãy bắt đầu bằng điều cả hai cùng đồng ý.",
   "note": "bắt đầu bằng đồng ý"
  },
  {
   "id": "S79",
   "size": "wide",
   "key": 30,
   "len": 73,
   "first": 5618,
   "line": "Mình đều muốn dự án xong sớm, đúng không?",
   "note": "dự án xong sớm?"
  },
  {
   "id": "S80",
   "size": "close-up",
   "key": 18,
   "len": 21,
   "first": 5691,
   "line": "Vâng.",
   "note": "vâng"
  },
  {
   "id": "S81",
   "size": "two-shot",
   "key": 30,
   "len": 60,
   "first": 5712,
   "line": "Khách đang khó chịu vì phải chờ lâu?",
   "note": "khách chờ lâu?"
  },
  {
   "id": "S82",
   "size": "close-up",
   "key": 18,
   "len": 23,
   "first": 5772,
   "line": "Vâng.",
   "note": "vâng"
  },
  {
   "id": "S83",
   "size": "wide",
   "key": 30,
   "len": 86,
   "first": 5795,
   "line": "Đến câu thứ ba, người ta đã quen gật đầu.",
   "note": "quen gật đầu"
  },
  {
   "id": "S84",
   "size": "card",
   "key": 30,
   "len": 83,
   "first": 5881,
   "line": "Carnegie gọi đây là cách của Socrates.",
   "note": "Socrates"
  },
  {
   "id": "S85",
   "size": "insert",
   "key": 30,
   "len": 35,
   "first": 5964,
   "line": "Ngày 21.",
   "note": "NGÀY 21"
  },
  {
   "id": "S86",
   "size": "close-up",
   "key": 18,
   "len": 44,
   "first": 5999,
   "line": "Bạn làm sai một việc.",
   "note": "làm sai"
  },
  {
   "id": "S87",
   "size": "wide",
   "key": 30,
   "len": 129,
   "first": 6043,
   "line": "Lần này, bạn nhận lỗi trước, nhanh và rõ ràng, trước khi sếp kịp nói.",
   "note": "nhận lỗi trước"
  },
  {
   "id": "S88",
   "size": "close-up",
   "key": 18,
   "len": 62,
   "first": 6172,
   "line": "Sếp định trách, rồi lại quay sang động viên",
   "note": "sếp động viên"
  },
  {
   "id": "S89",
   "size": "two-shot",
   "key": 30,
   "len": 146,
   "first": 6234,
   "line": "bạn. Bạn thử thêm một cách: đặt câu hỏi, để người khác tự nghĩ ra ý tưởng.",
   "note": "đặt câu hỏi"
  },
  {
   "id": "S90",
   "size": "close-up",
   "key": 18,
   "len": 75,
   "first": 6380,
   "line": "Vì ai cũng tin ý tưởng của chính mình hơn.",
   "note": "ý tưởng của chính mình"
  },
  {
   "id": "S91",
   "size": "insert",
   "key": 30,
   "len": 36,
   "first": 6455,
   "line": "Ngày 23.",
   "note": "NGÀY 23"
  },
  {
   "id": "S92",
   "size": "card",
   "key": 30,
   "len": 75,
   "first": 6491,
   "line": "Bạn tập nhìn mọi việc từ góc độ của người kia.",
   "note": "góc nhìn"
  },
  {
   "id": "S93",
   "size": "close-up",
   "key": 18,
   "len": 61,
   "first": 6566,
   "line": "Hàng xóm mở nhạc to lúc nửa đêm.",
   "note": "nhạc to nửa đêm"
  },
  {
   "id": "S94",
   "size": "two-shot",
   "key": 30,
   "len": 128,
   "first": 6627,
   "line": "Thay vì đập cửa, bạn hỏi: chắc hôm nay nhà mình có chuyện vui à?",
   "note": "có chuyện vui à?"
  },
  {
   "id": "S95",
   "size": "close-up",
   "key": 18,
   "len": 75,
   "first": 6755,
   "line": "Anh ấy ngượng ngùng, xin lỗi, rồi vặn nhỏ.",
   "note": "xin lỗi, vặn nhỏ"
  },
  {
   "id": "S96",
   "size": "close-up",
   "key": 18,
   "len": 43,
   "first": 6830,
   "line": "Ai cũng có lý do của họ.",
   "note": "ai cũng có lý do"
  },
  {
   "id": "S97",
   "size": "card",
   "key": 30,
   "len": 77,
   "first": 6873,
   "line": "Hiểu được lý do đó, bạn đã cầm chìa khoá.",
   "note": "cầm chìa khoá"
  },
  {
   "id": "S98",
   "size": "insert",
   "key": 30,
   "len": 35,
   "first": 6950,
   "line": "Ngày 25.",
   "note": "NGÀY 25"
  },
  {
   "id": "S99",
   "size": "card",
   "key": 30,
   "len": 115,
   "first": 6985,
   "line": "Phần bốn: giúp người khác thay đổi mà không làm họ tự ái.",
   "note": "phần 4"
  },
  {
   "id": "S100",
   "size": "wide",
   "key": 30,
   "len": 57,
   "first": 7100,
   "line": "Bạn kèm một bạn thực tập.",
   "note": "kèm thực tập"
  },
  {
   "id": "S101",
   "size": "close-up",
   "key": 18,
   "len": 59,
   "first": 7157,
   "line": "Bạn bắt đầu bằng lời khen.",
   "note": "bắt đầu bằng lời khen"
  },
  {
   "id": "S102",
   "size": "two-shot",
   "key": 30,
   "len": 47,
   "first": 7216,
   "line": "Nhắc lỗi một cách gián tiếp.",
   "note": "nhắc lỗi gián tiếp"
  },
  {
   "id": "S103",
   "size": "close-up",
   "key": 18,
   "len": 47,
   "first": 7263,
   "line": "Kể lỗi của chính mình trước.",
   "note": "kể lỗi mình trước"
  },
  {
   "id": "S104",
   "size": "two-shot",
   "key": 30,
   "len": 61,
   "first": 7310,
   "line": "Đặt câu hỏi thay vì ra lệnh.",
   "note": "hỏi thay vì ra lệnh"
  },
  {
   "id": "S105",
   "size": "close-up",
   "key": 18,
   "len": 60,
   "first": 7371,
   "line": "Và khen cả tiến bộ nhỏ nhất.",
   "note": "khen tiến bộ nhỏ"
  },
  {
   "id": "S106",
   "size": "wide",
   "key": 30,
   "len": 81,
   "first": 7431,
   "line": "Hai tuần sau, bạn ấy làm tốt hơn bạn mong đợi.",
   "note": "làm tốt hơn mong đợi"
  },
  {
   "id": "S107",
   "size": "close-up",
   "key": 18,
   "len": 51,
   "first": 7512,
   "line": "Nhưng có một cái bẫy.",
   "note": "cái bẫy"
  },
  {
   "id": "S108",
   "size": "wide",
   "key": 30,
   "len": 83,
   "first": 7563,
   "line": "Nếu bạn dùng những điều này như mánh khoé, người ta sẽ nhận ra.",
   "note": "mánh khoé bị nhận ra"
  },
  {
   "id": "S109",
   "size": "quote",
   "key": 30,
   "len": 159,
   "first": 7646,
   "line": "Carnegie nói rõ: lời khen giả dối là nịnh hót, và nịnh hót sớm muộn cũng lộ.",
   "note": "nịnh hót sớm muộn cũng lộ"
  },
  {
   "id": "S110",
   "size": "book",
   "key": 30,
   "len": 58,
   "first": 7805,
   "line": "Đắc Nhân Tâm không dạy bạn diễn.",
   "note": "không dạy bạn diễn"
  },
  {
   "id": "S111",
   "size": "street",
   "key": 30,
   "len": 76,
   "first": 7863,
   "line": "Nó dạy bạn thật sự quan tâm đến người khác.",
   "note": "thật sự quan tâm"
  },
  {
   "id": "S112",
   "size": "close-up",
   "key": 18,
   "len": 47,
   "first": 7939,
   "line": "Và đó là phần khó nhất.",
   "note": "phần khó nhất"
  },
  {
   "id": "S113",
   "size": "insert",
   "key": 30,
   "len": 33,
   "first": 7986,
   "line": "Ngày 30.",
   "note": "NGÀY 30"
  },
  {
   "id": "S114",
   "size": "close-up",
   "key": 18,
   "len": 44,
   "first": 8019,
   "line": "Không có phép màu nào cả.",
   "note": "không có phép màu"
  },
  {
   "id": "S115",
   "size": "wide",
   "key": 30,
   "len": 102,
   "first": 8063,
   "line": "Chỉ là mọi người quanh bạn dễ chịu hơn, vì chính bạn dễ chịu hơn.",
   "note": "mọi người dễ chịu hơn"
  },
  {
   "id": "S116",
   "size": "card",
   "key": 30,
   "len": 69,
   "first": 8165,
   "line": "Cuốn sách ra đời năm 1936,",
   "note": "1936"
  },
  {
   "id": "S117",
   "size": "card",
   "key": 30,
   "len": 132,
   "first": 8234,
   "line": "đã bán hơn 30 triệu bản, và đến giờ vẫn được đọc khắp thế giới.",
   "note": "30 triệu bản"
  },
  {
   "id": "S118",
   "size": "card",
   "key": 30,
   "len": 90,
   "first": 8366,
   "line": "Nó có 30 nguyên tắc. Bạn vừa nghe hơn một nửa.",
   "note": "30 nguyên tắc"
  },
  {
   "id": "S119",
   "size": "book",
   "key": 30,
   "len": 124,
   "first": 8456,
   "line": "Phần còn lại, cùng những câu chuyện thật đằng sau từng nguyên tắc, nằm trong sách.",
   "note": "phần còn lại trong sách"
  },
  {
   "id": "S120",
   "size": "close-up",
   "key": 18,
   "len": 78,
   "first": 8580,
   "line": "Nếu chỉ đọc một cuốn về giao tiếp, hãy bắt đầu từ cuốn",
   "note": "bắt đầu từ cuốn này"
  },
  {
   "id": "CTA",
   "size": "end card",
   "key": 30,
   "len": 239,
   "first": 8658,
   "line": "này. Link sách ở ngay bên dưới. Đọc thử vài trang, bạn sẽ hiểu vì sao nó sống được gần một trăm năm.",
   "note": "link sách bên dưới"
  }
